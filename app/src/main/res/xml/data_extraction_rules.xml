<?xml version="1.0" encoding="utf-8"?>
<!-- The account session (account.xml) is encrypted with a Keystore key that does not leave
     the device, so it is left out: a restored or transferred app starts signed out.
     See https://developer.android.com/about/versions/12/backup-restore#xml-changes -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="account.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="account.xml" />
    </device-transfer>
</data-extraction-rules>
