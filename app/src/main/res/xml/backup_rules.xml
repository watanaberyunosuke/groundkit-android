<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older (see data_extraction_rules.xml for 12 and later). The account
     session is encrypted with a Keystore key that does not leave the device, so it is left out.
     See https://developer.android.com/guide/topics/data/autobackup -->
<full-backup-content>
    <exclude domain="sharedpref" path="account.xml" />
</full-backup-content>
